# ─── raihanghorami.com, Apache / LiteSpeed (Hostinger) ─────────────────────
# Upload the CONTENTS of `out/` into public_html. This file travels with it.

ErrorDocument 404 /404.html

# Private newsletter configuration, if the protected fallback is needed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.newsletter-private(?:/|$) - [F,L]
</IfModule>

# The former unpublished Notes area now lives under Writing.
RedirectMatch 301 ^/notes/?$ https://raihanghorami.com/writing/a-clear-handoff-before-the-first-cut/

# Pages folded into the one-page site (Oct 2026). NE keeps the # anchor intact.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^about/?$ https://raihanghorami.com/#about [R=301,NE,L]
  RewriteRule ^work/?$ https://raihanghorami.com/ [R=301,L]
  RewriteRule ^contact/?$ https://raihanghorami.com/#contact [R=301,NE,L]
  RewriteRule ^writing/?$ https://raihanghorami.com/writing/a-clear-handoff-before-the-first-cut/ [R=301,L]
</IfModule>

# Force HTTPS and drop the www prefix.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build output never changes under the same name.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/avif               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"

  # HTML must revalidate so a redeploy is picked up immediately.
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HTML and the .txt RSC payloads both change every build at a stable URL.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/avif    .avif
  AddType font/woff2    .woff2
</IfModule>
